---
import { BRAND, META, link, abs } from '../lib/data.js';
import Doodles from '../components/Doodles.astro';
import '../styles/global.css';
const { title, description, doodles, type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${BRAND.name}` : `${BRAND.name}: ${BRAND.tagline}`;
const desc = description ?? BRAND.tagline;
const pagePath = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length) || '/';
const url = abs(pagePath);
const shareImage = abs('/og-image.png');

// Brand tokens become CSS variables, so brand.json is the only place to change the look.
const kebab = (k) => k.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`);
const vars = {
  ...Object.fromEntries(Object.entries(BRAND.colors).map(([k, v]) => [kebab(k), v])),
  'font-heading': BRAND.fonts.heading,
  'font-body': BRAND.fonts.body,
  'font-size': BRAND.fonts.baseSize,
  radius: BRAND.shape.radius,
  'sheet-opacity': BRAND.doodles.enabled ? BRAND.doodles.sheetOpacity : 1,
  'doodle-opacity': BRAND.doodles.opacity,
  'doodle-outline': BRAND.doodles.outline,
};
const brandCss = `:root{${Object.entries(vars).map(([k, v]) => `--${k}:${v}`).join(';')}}`;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && Astro.site && <link rel="canonical" href={url} />}
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />
    <meta name="theme-color" content={BRAND.colors.bg} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="he_IL" />
    {Astro.site && <meta property="og:url" content={url} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {BRAND.fonts.googleFontsUrl && <link href={BRAND.fonts.googleFontsUrl} rel="stylesheet" />}
    <style is:inline set:html={brandCss} />
    <slot name="head" />
  </head>
  <body>
    {BRAND.doodles.enabled && <Doodles ids={doodles} animate={BRAND.doodles.animate} />}
    <header class="site-header">
      <a class="brand" href={link('/')}>{BRAND.name}</a>
      <nav>
        {META.nav.map((n) => <a href={link(n.href)} aria-current={Astro.url.pathname === link(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>{BRAND.footerNote}</p>
    </footer>
  </body>
</html>
