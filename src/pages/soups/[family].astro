---
import Base from '../../layouts/Base.astro';
import Finder from '../../components/Finder.astro';
import { link, abs, breadcrumbs, BRAND, META, familyMembers, familyReference, totalTime, fmtTime } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.keys(META.families).map((family) => ({ params: { family } }));
}

const { family } = Astro.params;
const info = META.families[family];
const compare = info.compare !== false;
const ref = familyReference(family);
// Classic first, then the local versions, then the ones from around the world.
const rank = (r) => (r.slug === ref.slug ? 0 : r.scope === 'local' ? 1 : 2);
const members = familyMembers(family).sort((a, b) => rank(a) - rank(b));
const flavorKeys = Object.keys(META.flavors);
const count = members.length === 1 ? 'מתכון אחד' : compare ? `${members.length} גרסאות` : `${members.length} מתכונים`;

const crumbs = breadcrumbs([[BRAND.name, '/'], [info.title, `/soups/${family}/`]]);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: info.title,
  itemListElement: members.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.title, url: abs(`/recipes/${r.slug}/`) })),
};
---
<Base title={compare && members.length > 1 ? `${info.title}: ${count} והשוואה ביניהן` : info.title} description={info.intro} doodles={members.flatMap((r) => r.ingredients.map((l) => l.id))}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  <p class="crumbs"><a href={link('/')}>כל המרקים</a> ‹ {info.title}</p>
  <h1>{info.title}</h1>
  <p class="lead">{info.intro}</p>

  {compare && members.length > 1 && (
    <>
      <h2>השוואה בין הגרסאות</h2>
      <p class="muted small">כמה מכל טעם יש בכל גרסה, ומה נותן לה את האופי. לחיצה על טעם ממיינת לפיו.</p>
      <div class="table-wrap">
        <table class="compare" id="compare">
          <thead>
            <tr>
              <th>גרסה</th>
              {flavorKeys.map((k) => <th class="num"><button type="button" class="sort" data-sort={k} aria-pressed="false">{META.flavors[k]}</button></th>)}
              <th>מה נותן לו את האופי</th>
              <th>מסורת</th>
              <th>זמן</th>
            </tr>
          </thead>
          <tbody>
            {members.map((r, i) => (
              <tr data-i={i} {...Object.fromEntries(flavorKeys.map((k) => [`data-${k}`, r.flavor[k] ?? 0]))}>
                <td><a href={link(`/recipes/${r.slug}/`)}>{r.short}</a></td>
                {flavorKeys.map((k) => {
                  const v = r.flavor[k] ?? 0;
                  return (
                    <td class="num">
                      <span class="dots" role="img" aria-label={`${META.flavors[k]}: ${v} מתוך 3`}>
                        {[1, 2, 3].map((n) => <i class:list={[{ on: n <= v }]} />)}
                      </span>
                    </td>
                  );
                })}
                <td>{r.character.join(' · ')}</td>
                <td>{r.tradition}</td>
                <td style="white-space:nowrap">{fmtTime(totalTime(r))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h2>{members.length === 1 ? 'המתכון' : compare ? 'בחירת גרסה' : 'כל התוספות'}</h2>
  <Finder family={family} />
</Base>

<script>
  // Sort the comparison by a flavor, strongest first; a second click restores the original order.
  const table = document.getElementById('compare');
  if (table) {
    const body = table.tBodies[0];
    const rows = [...body.rows];
    let current = null;
    table.addEventListener('click', (e) => {
      const btn = e.target.closest('button.sort');
      if (!btn) return;
      const key = btn.dataset.sort;
      current = current === key ? null : key;
      const sorted = current
        ? [...rows].sort((a, b) => b.dataset[current] - a.dataset[current] || a.dataset.i - b.dataset.i)
        : rows;
      body.append(...sorted);
      for (const b of table.querySelectorAll('button.sort')) b.setAttribute('aria-pressed', String(b.dataset.sort === current));
    });
  }
</script>
