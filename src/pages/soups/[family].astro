---
import Base from '../../layouts/Base.astro';
import Finder from '../../components/Finder.astro';
import { link, abs, breadcrumbs, BRAND, META, familyMembers, familyReference, diff, he, totalTime, fmtTime } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.keys(META.families).map((family) => ({ params: { family } }));
}

const { family } = Astro.params;
const info = META.families[family];
const compare = info.compare !== false;
const ref = familyReference(family);
// Reference first, then the local versions, then the ones from around the world.
const rank = (r) => (r.slug === ref.slug ? 0 : r.scope === 'local' ? 1 : 2);
const members = familyMembers(family).sort((a, b) => rank(a) - rank(b));
const names = (list) => list.map(he).join(', ');
const count = members.length === 1 ? 'מתכון אחד' : compare ? `${members.length} גרסאות` : `${members.length} מתכונים`;

const crumbs = breadcrumbs([[BRAND.name, '/'], [info.title, `/soups/${family}/`]]);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: info.title,
  itemListElement: members.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.title, url: abs(`/recipes/${r.slug}/`) })),
};
---
<Base title={compare && members.length > 1 ? `${info.title}: ${count} והשוואה ביניהן` : info.title} description={info.intro} doodles={members.flatMap((r) => r.ingredients.map((l) => l.id))}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  <p class="crumbs"><a href={link('/')}>כל המרקים</a> ‹ {info.title}</p>
  <h1>{info.title}</h1>
  <p class="lead">{info.intro}</p>

  {compare && members.length > 1 && (
    <>
      <h2>השוואה בין הגרסאות</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>גרסה</th><th>מסורת</th><th>סוג</th><th>זמן</th><th>מה נוסף לעומת {ref.short}</th><th>מה יורד</th></tr>
          </thead>
          <tbody>
            {members.map((r) => {
              const d = diff(r, ref);
              const isRef = r.slug === ref.slug;
              return (
                <tr class:list={[{ ref: isRef }]}>
                  <td><a href={link(`/recipes/${r.slug}/`)}>{r.short}</a></td>
                  <td>{r.tradition}</td>
                  <td>{META.types[r.type]}</td>
                  <td style="white-space:nowrap">{fmtTime(totalTime(r))}</td>
                  {isRef
                    ? <td colspan="2" class="muted">כל שאר הגרסאות מושוות למרק הזה</td>
                    : <>
                        <td class="plus">{names(d.added) || '–'}</td>
                        <td class="minus">{names(d.removed) || '–'}</td>
                      </>}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h2>{members.length === 1 ? 'המתכון' : compare ? 'בחירת גרסה' : 'כל התוספות'}</h2>
  <Finder family={family} />
</Base>
