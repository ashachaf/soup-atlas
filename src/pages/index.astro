---
import Base from '../layouts/Base.astro';
import Finder from '../components/Finder.astro';
import { BRAND, recipes } from '../lib/data.js';
---
<Base description={`${recipes.length} מתכוני מרק עם חיפוש לפי סוג, מסורת, טעם ומרכיבים שיש בבית. כל הגרסאות של כל מרק זו לצד זו.`}>
  <h1>{BRAND.name}</h1>
  <p class="lead">{BRAND.tagline}. מסננים לפי סוג, מסורת וטעם, או מסמנים מה יש במקרר ורואים איזה מרק הכי קרוב.</p>
  <Finder />
</Base>
